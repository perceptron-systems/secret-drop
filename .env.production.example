# =============================================================================
# SECRET DROP - PRODUCTION ENVIRONMENT (HARDENED)
# =============================================================================
#
# Copy this file to .env on your production server and fill in the values.
# Lines marked [REQUIRED] must be set before deployment.
# Lines marked [CHANGE] should be adapted to your infrastructure.
#
# =============================================================================

# [REQUIRED] Generate with: php artisan key:generate --show
APP_NAME="Secret Drop"
APP_KEY=

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# [REQUIRED] Your production domain with HTTPS
APP_URL=https://secret-drop.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Higher rounds = slower brute-force
BCRYPT_ROUNDS=14

# -----------------------------------------------------------------------------
# LOGGING (production: only warnings and above)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=28
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# [REQUIRED] Configure your database credentials
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=secretdrop
DB_USERNAME=secretdrop
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION (hardened)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# [CHANGE] Set to your domain (e.g. .secret-drop.example.com)
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# "lax" is required for magic link auth (clicked from email = cross-site navigation)
# "strict" would block the session cookie on the initial click
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# DRIVERS
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# -----------------------------------------------------------------------------
# MAIL (SMTP)
# -----------------------------------------------------------------------------
# [REQUIRED] Configure your SMTP server
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# [REQUIRED] Your sender address
MAIL_FROM_ADDRESS="noreply@secret-drop.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DKIM Signing (optional - only if your SMTP doesn't sign)
# MAIL_DKIM_DOMAIN=secret-drop.example.com
# MAIL_DKIM_SELECTOR=secretdrop
# MAIL_DKIM_PRIVATE_KEY_PATH=storage/dkim/private.key
# MAIL_DKIM_PASSPHRASE=

# -----------------------------------------------------------------------------
# ENCRYPTED FILES STORAGE
# -----------------------------------------------------------------------------
SECRETS_DISK_DRIVER=local
# For S3 storage (optional):
# SECRETS_DISK_DRIVER=s3
# SECRETS_AWS_ACCESS_KEY_ID=
# SECRETS_AWS_SECRET_ACCESS_KEY=
# SECRETS_AWS_DEFAULT_REGION=eu-west-3
# SECRETS_AWS_BUCKET=secret-drop-files
# SECRETS_AWS_ENDPOINT=

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# LEGAL MENTIONS
# -----------------------------------------------------------------------------
# [CHANGE] Your legal entity information
LEGAL_EDITOR_NAME="Secret Drop"
# LEGAL_EDITOR_ADDRESS=        # Optional: required for professional editors (LCEN)
# LEGAL_EDITOR_PHONE=          # Optional: required for professional editors (LCEN)
LEGAL_HOSTING_NAME="Your Hosting Provider"
LEGAL_HOSTING_ADDRESS="123 Hosting Street, City, Country"
LEGAL_HOSTING_PHONE="+00 0 00 00 00 00"
LEGAL_CONTACT_EMAIL="${MAIL_FROM_ADDRESS}"

# -----------------------------------------------------------------------------
# ADMINISTRATION
# -----------------------------------------------------------------------------
# [REQUIRED] Email address for the super admin dashboard
SUPER_ADMIN_EMAIL=admin@example.com
