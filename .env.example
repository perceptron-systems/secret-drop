# =============================================================================
# SECRET DROP - ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] must be set before first run.
# Lines marked [CHANGE] should be adapted to your setup.
#
# For production, use .env.production.example as a hardened template.
#
# =============================================================================

# [REQUIRED] Generate with: php artisan key:generate --show
APP_NAME="Secret Drop"
APP_KEY=

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Lower rounds for faster dev/test cycles (production: 14)
BCRYPT_ROUNDS=12

# Trusted reverse proxies (comma-separated IPs/CIDRs).
# Leave empty if your web server (Apache/nginx) is exposed directly to the internet.
# Set to "127.0.0.1" if a local reverse-proxy fronts PHP-FPM.
# Set to your LB/CDN IP range if behind Cloudflare/OVH LB/etc.
# DO NOT use "*" unless a proxy is guaranteed in front — IP spoofing risk.
TRUSTED_PROXIES=

# Pepper used as HMAC key when hashing creator emails (DB-leak protection).
# Leave empty to derive from APP_KEY automatically. Override only to rotate
# the pepper independently of APP_KEY (invalidates all existing hashes).
EMAIL_HASH_PEPPER=

# -----------------------------------------------------------------------------
# LOGGING (production: LOG_LEVEL=warning)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
# LOG_DAILY_DAYS=28
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# "lax" is required for magic link auth (clicked from email = cross-site navigation)
# "strict" would block the session cookie on the initial click
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# DRIVERS
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Use "memcached" for better performance if memcached is installed
CACHE_STORE=file
# MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DKIM Signing (optional - only if your SMTP doesn't sign)
# See docs/email-configuration.md for setup
# MAIL_DKIM_DOMAIN=example.com
# MAIL_DKIM_SELECTOR=secretdrop
# MAIL_DKIM_PRIVATE_KEY_PATH=storage/dkim/private.key
# MAIL_DKIM_PASSPHRASE=

# -----------------------------------------------------------------------------
# SECURITY & LIMITS
# -----------------------------------------------------------------------------
# Proof-of-Work difficulty (leading zero bits in SHA-256, 20 ≈ 1-2s)
POW_DIFFICULTY=20

# Rate limiting (secrets created per day per IP)
SECRETS_DAILY_LIMIT_PER_IP=50

# File storage quota in MB (0 = unlimited)
SECRETS_FILE_STORAGE_QUOTA_MB=5120

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# LEGAL MENTIONS
# -----------------------------------------------------------------------------
# [REQUIRED] Your legal entity information
LEGAL_EDITOR_NAME="Secret Drop"
# LEGAL_EDITOR_ADDRESS=        # Optional: required for professional editors (LCEN)
# LEGAL_EDITOR_PHONE=          # Optional: required for professional editors (LCEN)
# LEGAL_ORGANIZATION_NAME=     # Organization/company name for schema.org (defaults to APP_NAME)
LEGAL_HOSTING_NAME="Your Hosting Provider"
LEGAL_HOSTING_ADDRESS="123 Hosting Street, City, Country"
LEGAL_HOSTING_PHONE="+00 0 00 00 00 00"
LEGAL_CONTACT_EMAIL="${MAIL_FROM_ADDRESS}"

# -----------------------------------------------------------------------------
# SOCIAL (schema.org sameAs)
# -----------------------------------------------------------------------------
# [CHANGE] Social / sameAs links (for schema.org structured data)
# SOCIAL_GITHUB=https://github.com/your-org/your-repo
# SOCIAL_TWITTER=https://x.com/your_handle
# SOCIAL_LINKEDIN=https://linkedin.com/company/your-company
# SOCIAL_WEBSITE=https://your-website.com

# -----------------------------------------------------------------------------
# SEO / SEARCH CONSOLE
# -----------------------------------------------------------------------------
# Google Search Console verification token (meta tag method).
# Leave empty to omit the meta tag entirely.
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (meta tag method).
# Alternative methods: XML file in /public (gitignored) or DNS CNAME record.
# Leave empty to omit the meta tag entirely.
# BING_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# ADMINISTRATION
# -----------------------------------------------------------------------------
# Admin session duration in minutes after magic link auth (default: 15)
ADMIN_SESSION_TTL=60

# -----------------------------------------------------------------------------
# SUPER ADMINISTRATION
# -----------------------------------------------------------------------------
# Super admin session duration in minutes after magic link auth (default: 15)
SUPER_ADMIN_SESSION_TTL=60
# [CHANGE] Email address for the super admin dashboard
SUPER_ADMIN_EMAIL=
